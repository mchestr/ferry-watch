{
  // Tests run under Vitest in Node (jsdom), and Vitest's types pull in Node's.
  // Keeping them out of tsconfig.app.json stops those types leaking into browser code.
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": ["vite/client", "node"]
  },
  "include": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/test", "src/env.d.ts"],
  "exclude": []
}
