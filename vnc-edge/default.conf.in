# vnc-edge: the checkout host (docs/multi-tenant/design-reference.md §7.9). Static files, and one
# WebSocket proxy to each browser pod's gate. No app code, no secrets. build.py fills in the two
# placeholders: the checkout host and the hash of vnc.html's one inline script.
map $http_upgrade $connection_upgrade { default upgrade; '' close; }
log_format noargs '$remote_addr [$time_local] "$request_method $uri" $status $body_bytes_sent $request_time';

server {
  listen 8080;
  access_log /dev/stdout noargs;  # $uri, never the query string
  server_tokens off;
  resolver kube-dns.kube-system.svc.cluster.local valid=5s ipv6=off;

  add_header Content-Security-Policy "__FW_CSP__" always;
  add_header Referrer-Policy no-referrer always;
  add_header X-Content-Type-Options nosniff always;
  add_header Cache-Control no-store always;

  location ~ "^/t/[a-f0-9]{16}/g/[0-9]{1,6}/$" { root /usr/share/fw-vnc; try_files /fw/landing.html =404; }
  location = /vnc.html { root /usr/share/fw-vnc; }
  location ~ "^/(assets|app|core|fw)/" { root /usr/share/fw-vnc; }

  location ~ "^/t/(?<trip>[a-f0-9]{16})/g/(?<gen>[0-9]{1,6})/ws$" {
    if ($http_upgrade != "websocket") { return 400; }
    proxy_pass http://fw-$trip-g$gen.browsers.ferry-watch-browsers.svc.cluster.local:6080/ws;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Cookie "";
    proxy_set_header Authorization "";
    proxy_hide_header Set-Cookie;
    add_header Content-Security-Policy "sandbox" always;
    proxy_buffering off;
    proxy_read_timeout 6100s;
    proxy_send_timeout 6100s;
    proxy_intercept_errors on;
    error_page 502 503 504 =410 /gone.html;  # no such pod: the hold is over
  }

  location = /gone.html { root /usr/share/fw-vnc; }
  location / { return 404; }
}
