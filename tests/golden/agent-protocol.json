{
  "AgentMessage": {
    "$defs": {
      "Alert": {
        "additionalProperties": false,
        "description": "Something the user should hear about. The operator writes the words and the links.",
        "properties": {
          "boot": {
            "pattern": "^[a-f0-9]{8,32}$",
            "type": "string"
          },
          "kind": {
            "enum": [
              "bookable",
              "cart_expired",
              "cart_failed",
              "cart_held",
              "cart_lost",
              "checkout_blocked",
              "failing",
              "hold_ending",
              "hold_reminder",
              "release_unverified"
            ]
          },
          "params": {
            "$ref": "#/$defs/AlertParams"
          },
          "rev": {
            "minimum": 0,
            "type": "integer"
          },
          "seq": {
            "minimum": 0,
            "type": "integer"
          },
          "trip": {
            "pattern": "^[a-z0-9]{1,32}$",
            "type": "string"
          },
          "type": {
            "enum": [
              "alert"
            ]
          },
          "v": {
            "default": 1,
            "enum": [
              1
            ]
          }
        },
        "required": [
          "type",
          "seq",
          "trip",
          "boot",
          "rev",
          "kind"
        ],
        "title": "Alert",
        "type": "object"
      },
      "AlertParams": {
        "additionalProperties": false,
        "properties": {
          "by_site": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "departures": {
            "default": [],
            "items": {
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
              "type": "string"
            },
            "maxItems": 10,
            "type": "array"
          },
          "error_class": {
            "anyOf": [
              {
                "enum": [
                  "booking",
                  "cart_mismatch",
                  "login_failed",
                  "markup_changed",
                  "not_bookable",
                  "queue_timeout",
                  "route_rejected",
                  "session_expired",
                  "timeout",
                  "unexpected"
                ]
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "fare": {
            "anyOf": [
              {
                "maxLength": 32,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "minutes": {
            "anyOf": [
              {
                "maximum": 10000000,
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "price": {
            "anyOf": [
              {
                "maxLength": 24,
                "pattern": "^[\\w$.,\\- ]*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [],
        "title": "AlertParams",
        "type": "object"
      },
      "Bye": {
        "additionalProperties": false,
        "description": "The agent's last word before it exits.",
        "properties": {
          "boot": {
            "pattern": "^[a-f0-9]{8,32}$",
            "type": "string"
          },
          "cart_emptied": {
            "default": false,
            "type": "boolean"
          },
          "outcome": {
            "default": "none",
            "enum": [
              "booked",
              "expired",
              "expired_by_site",
              "none",
              "payment_left_to_site",
              "released"
            ]
          },
          "reason": {
            "enum": [
              "deadline",
              "drained",
              "fatal",
              "hold_ended",
              "lockdown_failed",
              "recycle",
              "short_check_done",
              "smoke_done",
              "startup_failed"
            ]
          },
          "release_check": {
            "default": "none",
            "enum": [
              "cart_empty",
              "landing_url",
              "none"
            ]
          },
          "rev": {
            "minimum": 0,
            "type": "integer"
          },
          "seq": {
            "minimum": 0,
            "type": "integer"
          },
          "trip": {
            "pattern": "^[a-z0-9]{1,32}$",
            "type": "string"
          },
          "type": {
            "enum": [
              "bye"
