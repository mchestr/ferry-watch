          },
          "rev": {
            "minimum": 0,
            "type": "integer"
          },
          "seq": {
            "minimum": 0,
            "type": "integer"
          },
          "trip": {
            "pattern": "^[a-z0-9]{1,32}$",
            "type": "string"
          },
          "type": {
            "enum": [
              "cart_claim"
            ]
          },
          "v": {
            "default": 1,
            "enum": [
              1
            ]
          }
        },
        "required": [
          "type",
          "seq",
          "trip",
          "boot",
          "rev",
          "depart",
          "fare"
