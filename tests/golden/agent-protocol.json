          "v": {
            "default": 1,
            "enum": [
              1
            ]
          },
          "viewer_was_connected": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "type",
          "seq",
          "trip",
          "boot",
          "rev",
          "reason"
        ],
        "title": "Bye",
        "type": "object"
      },
      "CartClaim": {
