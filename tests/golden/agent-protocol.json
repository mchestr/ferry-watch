      "Hello": {
        "additionalProperties": false,
        "description": "The first message on every connection: who this is, and what hasn't been acknowledged yet.",
        "properties": {
          "agent_version": {
            "maxLength": 64,
            "pattern": "^[\\w.+-]+$",
            "type": "string"
