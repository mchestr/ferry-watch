                {
                  "$ref": "#/$defs/Alert"
                },
                {
                  "$ref": "#/$defs/Bye"
                }
              ],
              "discriminator": {
                "mapping": {
                  "alert": "#/$defs/Alert",
                  "bye": "#/$defs/Bye",
                  "event": "#/$defs/Event"
                },
                "propertyName": "type"
              }
            },
            "maxItems": 200,
            "type": "array"
          },
          "v": {
            "default": 1,
            "enum": [
              1
            ]
