          },
          "gen": {
            "minimum": 0,
            "type": "integer"
          },
          "pod_name": {
            "pattern": "^wl-[a-z0-9]{1,32}-g\\d{1,6}$",
            "type": "string"
          },
          "proto": {
            "items": {
              "minimum": 1,
